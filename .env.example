# Copy to .env.local and fill with your own values. Do not commit real secrets.

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Issuer from Clerk JWT template named "convex", e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Convex deployment URL from `npx convex dev` (ends in .convex.cloud)
NEXT_PUBLIC_CONVEX_URL=

# Set these with `npx convex env set`, not in the Next.js bundle:
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# LENDLOOP_WEBHOOK_SECRET=
# N8N_REQUEST_WEBHOOK_URL=http://host.docker.internal:5678/webhook/lendloop-request
# ADMIN_EMAILS=you@example.com

# Shared HMAC secret. Generate your own, then set the same value in Convex.
# Example generator: openssl rand -hex 32
LENDLOOP_WEBHOOK_SECRET=

# n8n (docker compose). Use a long random string you generate yourself.
N8N_ENCRYPTION_KEY=

# Convex HTTP actions origin, e.g. https://happy-animal-123.convex.site
CONVEX_SITE_URL=
